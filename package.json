{
  "name": "atelier-dropship-store",
  "description": "Production-oriented dropshipping storefront for Cloudflare Pages",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=20.19.0 <23",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run test && npm run build",
    "pages:build": "npm run build",
    "pages:preview": "npm run build && wrangler pages dev dist --d1=DB=webshop --r2=PRODUCT_IMAGES=atelier-product-images",
    "pages:deploy": "npm run build && wrangler pages deploy dist",
    "cf:build": "npm run pages:build",
    "cf:preview": "npm run pages:preview",
    "cf:deploy": "npm run pages:deploy",
    "db:migrate:local": "wrangler d1 migrations apply webshop --local",
    "db:migrate:remote": "wrangler d1 migrations apply webshop --remote",
    "db:seed:local": "wrangler d1 execute webshop --local --file=./db/seed.sql",
    "db:seed:remote": "wrangler d1 execute webshop --remote --file=./db/seed.sql"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250806.0",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4",
    "wrangler": "^4.27.0"
  }
}
